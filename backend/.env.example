# =============================================================
# TK COMMS SENTINEL - Environment Configuration Template
# Copy this file to .env and fill in your values
# =============================================================

# JWT authentication secrets -- change both to random 40+ char strings
JWT_SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-AT-LEAST-40-CHARS
JWT_TEMP_SECRET=CHANGE-THIS-TOO-DIFFERENT-FROM-JWT-SECRET-ABOVE

# Database path. Relative paths resolve against the backend\ directory.
# In the versioned standalone layout, point this at the shared data folder
# so updates never touch it, e.g. C:\Program Files\TKCommsSentinel\data\netmonitor.db
DB_PATH=./db/netmonitor.db

# Application base URL -- used in email alert links
# Standalone listens on HTTPS directly. Example: https://192.168.1.100:9443
APP_BASE_URL=https://YOUR-SERVER-IP:9443

# =============================================================
# LDAP / Active Directory (leave empty to use local auth only)
# MUST use ldaps:// (TLS) -- plain ldap:// sends passwords in cleartext
# =============================================================
LDAP_URL=ldaps://your-dc.yourdomain.local:636
LDAP_BASE_DN=DC=yourdomain,DC=local
LDAP_BIND_DN=CN=svc-tksentinel,OU=Service Accounts,DC=yourdomain,DC=local

# Service account password -- also configurable in Admin > Settings after login
LDAP_BIND_PASSWORD=your-service-account-password

# Path to the internal CA certificate that signed the DC's TLS cert
# Must be PEM format. Place the file in the certs\ folder.
# Export from: certlm.msc -> Trusted Root CAs -> your CA -> export as Base-64
LDAP_CA_CERT=./certs/your-ca.pem

# Active Directory security groups for access control
AD_ADMIN_GROUP=NetMonitor_Admins
AD_VIEWER_GROUP=NetMonitor_Viewers

# =============================================================
# SMTP / Email Alerts (leave SMTP_HOST empty to disable)
# WARNING: do not set SMTP_HOST to a non-existent server --
# it will cause polling timeouts and break monitoring.
# =============================================================
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=tksentinel@yourdomain.local
SMTP_USER=
SMTP_PASS=

# Comma-separated alert recipient emails
ALERT_RECIPIENTS=admin@yourdomain.local

# =============================================================
# Application settings
# =============================================================
DEMO_MODE=false
DEFAULT_SNMP_COMMUNITY=public
SNMP_TIMEOUT_MS=5000

# Set to "production" so CORS is locked to same-origin. Leave unset for dev.
NODE_ENV=production

# =============================================================
# Standalone HTTPS server (no IIS)
# =============================================================
# The server terminates TLS itself and listens on HTTPS_PORT. Supply a
# certificate in ONE of two ways (checked in this order):
#
#   1. PFX (installer default) -- the installer generates a self-signed .pfx
#      with Windows' New-SelfSignedCertificate and sets these:
#         TLS_PFX_PATH=./certs/server.pfx
#         TLS_PFX_PASSWORD=<random, written by the installer>
#
#   2. PEM (bring your own cert) -- e.g. from an internal CA:
#         TLS_CERT_PATH=./certs/server-cert.pem
#         TLS_KEY_PATH=./certs/server-key.pem
#
# If no certificate is configured, the server falls back to plain HTTP on
# PORT -- development only, never for production.
HTTPS_PORT=9443
TLS_PFX_PATH=./certs/server.pfx
TLS_PFX_PASSWORD=
# TLS_CERT_PATH=./certs/server-cert.pem
# TLS_KEY_PATH=./certs/server-key.pem

# HTTP port. Used only as a development fallback when no TLS cert is set.
PORT=3001

# =============================================================
# AI Trend Analysis (optional -- requires internet access)
# Leave empty to use rule-based analysis only (works offline)
# Get a key at: https://console.anthropic.com
# =============================================================
CLAUDE_API_KEY=
