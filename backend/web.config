<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- API ו-כל השאר → Node.js (Node מגיש static + SPA fallback) -->
        <rule name="All to Node" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- devErrorsEnabled=false: כשהתהליך קורס לא מוחזרים ללקוח stack trace ונתיבים.
         enableXFF=true: iisnode מעביר את כתובת הלקוח האמיתית ב-X-Forwarded-For (בלעדיו
         השרת רואה רק את IIS, ולוג הביקורת לא יודע מי ניסה להתחבר). -->
    <iisnode
      node_env="production"
      nodeProcessCommandLine="C:\Program Files\nodejs\node.exe"
      loggingEnabled="true"
      logDirectory="iisnode-logs"
      debuggingEnabled="false"
      devErrorsEnabled="false"
      enableXFF="true"
    />

    <security>
      <requestFiltering removeServerHeader="true">
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment=".env.example" />
          <add segment="db" />
          <!-- שורש האתר הוא backend/, וה-rewrite מדלג על קבצים קיימים —
               בלי החסימות האלה הלוגים ניתנים להורדה ישירות מהדפדפן -->
          <add segment="logs" />
          <add segment="iisnode-logs" />
          <add segment="scripts" />
          <add segment="certs" />
          <!-- אותו דבר לקוד המקור: כל קובץ שקיים בשורש האתר מוגש ישירות על ידי IIS בלי התחברות.
               server.js עצמו לא חסום — הוא נקודת הכניסה של iisnode. -->
          <add segment="routes" />
          <add segment="services" />
          <add segment="middleware" />
          <add segment="lib" />
          <add segment="package.json" />
          <add segment="package-lock.json" />
          <add segment="poller-service.js" />
          <add segment="check-settings.js" />
          <add segment="check-lldp.js" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
