# === Dependencies ===
node_modules/

# === Environment / secrets (NEVER commit) ===
.env
.env.local
*.env.local

# === Database DATA (source code like database.js/schema.sql IS tracked) ===
*.db
*.db-shm
*.db-wal
*.db-journal
*.db.bak-*
*.pre-nodesqlite

# === Certificates / keys ===
certs/
*.pem
*.pfx
*.key
*.crt
*.p12
# ED25519 private key — NEVER commit
tools/keygen/private.pem

# === Logs ===
logs/
iisnode-logs/
*.log

# === Build output ===
frontend/dist/
dist/
build/
out/

# === Installer build artifacts ===
# Portable Node runtime, NSSM, downloaded archives, and the assembled
# distribution package are fetched/built on the build machine, never committed.
vendor/
package/
package-*/
dist-pkg/
*.exe
!install/**/*.exe

# === OS / editor / tooling junk ===
.claude/
.impeccable/
Thumbs.db
Desktop.ini
.DS_Store
